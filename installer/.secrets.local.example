# ─────────────────────────────────────────────────────────────────────
# Skyblue - Secrets pour l'auto-upload Supabase
# ─────────────────────────────────────────────────────────────────────
# COPIE ce fichier en `.secrets.local` (sans .example) et remplis les
# valeurs. Le fichier .secrets.local est deja dans .gitignore — il ne
# sera JAMAIS commit.
#
# La cle service_role donne un acces ADMIN complet a ta base Supabase.
# Ne la partage a personne. Ne l'envoie pas par mail / chat / etc.
#
# Ou la trouver :
#   1. Supabase Dashboard -> Project Settings -> API
#   2. Section "Project API keys"
#   3. Reveal la ligne "service_role" (secret) puis Copy
# ─────────────────────────────────────────────────────────────────────

SUPABASE_URL=https://wdwhfgawuozhkeflgcvs.supabase.co
SUPABASE_SERVICE_ROLE=colle-la-cle-service-role-ici
