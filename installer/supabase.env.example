# Copie ce fichier en `supabase.env` (meme dossier) et remplis les valeurs.
# `supabase.env` est ignore par git : les cles ne partent jamais dans le depot.
#
# Dashboard Supabase -> Project Settings -> API
#   Project URL              -> SUPABASE_URL
#   Project API keys / anon  -> SUPABASE_ANON_KEY
#
# N'utilise JAMAIS la cle `service_role` ici : elle contourne la RLS.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
